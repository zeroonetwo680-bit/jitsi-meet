# Public URL users open (must be https, same domain you set in Coolify on the "web" service)
PUBLIC_URL=https://meet.example.com
# VPS public IPv4 (needed so WebRTC media goes to the right address)
JVB_ADVERTISE_IPS=1.2.3.4
# Jitsi backend image tag. Use "stable" or a pinned "stable-XXXX-N"; "unstable" if this frontend is newer than stable.
JITSI_TAG=stable
TZ=Africa/Cairo

# Course defaults (already defaulted in docker-compose.yml, override only if needed)
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=internal
XMPP_GUEST_DOMAIN=guest.meet.jitsi
START_WITH_AUDIO_MUTED=true
START_WITH_VIDEO_MUTED=true
ENABLE_AV_MODERATION=1
